# Pinterest-App-Credentials  —  VORLAGE
# -------------------------------------------------------------------
# 1. App anlegen: https://developers.pinterest.com/  ->  deine App
# 2. Diese Datei kopieren:   cp .env.example .env
# 3. In .env die echten Werte eintragen (NICHT hier).
#
# .env ist gitignored -> dein Secret landet NIE im Repo oder im Chat.
# Diese .env.example bleibt versioniert (nur Platzhalter).
# -------------------------------------------------------------------

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Muss EXAKT der in der App registrierten Redirect-URI entsprechen:
PINTEREST_REDIRECT_URI=http://127.0.0.1:8585/callback
